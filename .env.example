# ==============================================================================
# HEALTHSHIELD AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Node Environment: development | demo | pilot | production
NODE_ENV=development
PORT=3001
VITE_API_URL=http://localhost:3001

# Database Configuration (PostgreSQL for production; SQLite for local/demo)
DB_TYPE=sqlite
DATABASE_URL=postgresql://healthshield_user:password@localhost:5432/healthshield_prod
SQLITE_DB_PATH=./data/healthshield_local.sqlite

# Security & Session Secrets (Must be at least 32 characters in production)
SESSION_SECRET=dev_session_secret_change_in_production_32chars!
JWT_SECRET=dev_jwt_secret_change_in_production_32chars!
COOKIE_SECURE=false

# CORS & Host Whitelist
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Nodemailer / SMTP Notifications (Nodemailer 2.0)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@ethereal.email
SMTP_PASSWORD=test_password
EMAIL_FROM=notifications@healthshield.ai

# AI Provider Configuration (Deterministic fallback active if empty)
AI_PROVIDER=LocalRuleProvider
EXTERNAL_AI_API_KEY=

# ABDM & Interoperability Gateway (Future standard endpoint)
ABDM_SANDBOX_ENDPOINT=https://dev.abdm.gov.in/gateway/v0.5
ABDM_CLIENT_ID=hs_demo_sandbox_id
